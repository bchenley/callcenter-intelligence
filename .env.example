# ---- LLM provider -----------------------------------------------------------
# Which provider the factory builds. Switching this is the ONLY change needed
# to move between paid and free inference. One of: openai | gemini | groq
LLM_PROVIDER=openai

# Only the key for your active provider is required; the others may stay unset.
OPENAI_API_KEY=              # GPT-4o  — best structured output, ~$0.03/call
GOOGLE_API_KEY=              # Gemini 2.0 Flash — 1500 req/day free, 15 RPM
GROQ_API_KEY=                # Llama 3.3 70B — 30 RPM free, fastest free tier

LLM_TIMEOUT_SECONDS=60       # raise to 120 if you hit timeouts on a free tier
MAX_RETRIES_PER_NODE=3       # exponential backoff: 1s, 2s, 4s, capped at 10s

# ---- Transcription ----------------------------------------------------------
# tiny (39MB) for development — loads in seconds, ~1 min per 5-min call on CPU.
# large-v3 ONLY on a CUDA box; it takes 25+ minutes per call on CPU.
WHISPER_MODEL_SIZE=tiny

CONFIDENCE_THRESHOLD=0.6       # per-segment confidence below this is [LOW CONF]
LOW_CONFIDENCE_HALT_RATIO=0.5  # fraction of low-conf segments that flags the call

# ---- Database ---------------------------------------------------------------
DB_PATH=data/calls.db
DB_ENCRYPTION_KEY=           # optional; sets a PRAGMA key on the SQLite engine

# ---- Observability (optional) ----------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=callcenter-intelligence
