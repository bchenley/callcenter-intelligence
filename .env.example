# callcenter-intelligence
# .env.example

# ---- LLM provider -----------------------------------------------------------
# Which provider the factory builds. Switching this is the ONLY change needed
# to move between paid and free inference. One of: openai | gemini | groq
LLM_PROVIDER=openai

# Only the key for your active provider is required; the others may stay unset.
# Docker --env-file treats everything after = as the value, including a trailing
# comment, so comments stay on their own lines.
# GPT-4o - best structured output, ~$0.03/call
OPENAI_API_KEY=
# Gemini 2.0 Flash - 1500 req/day free, 15 RPM
GOOGLE_API_KEY=
# Llama 3.3 70B - 30 RPM free, fastest free tier
GROQ_API_KEY=

# raise to 120 if you hit timeouts on a free tier
LLM_TIMEOUT_SECONDS=60
# exponential backoff: 1s, 2s, 4s, capped at 10s
MAX_RETRIES_PER_NODE=3

# ---- Transcription ----------------------------------------------------------
# base (~74MB) is the default: fewer ASR artifacts than tiny on CPU, still
# loads in tens of seconds. large-v3 ONLY on a CUDA box; tens of minutes on CPU.
WHISPER_MODEL_SIZE=base

# per-segment confidence below this is [LOW CONF]
CONFIDENCE_THRESHOLD=0.6
# fraction of low-conf segments that flags the call
LOW_CONFIDENCE_HALT_RATIO=0.5

# ---- Database ---------------------------------------------------------------
DB_PATH=data/calls.db
# optional; sets a PRAGMA key on the SQLite engine
DB_ENCRYPTION_KEY=

# ---- Observability (optional) ----------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=callcenter-intelligence
