# callcenter-intelligence
# .gitignore

# Real keys stay out of git. .env.example is the template IK requires.
.env
.env.*
!.env.example

.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.DS_Store
.vscode/
.idea/
.cursor/
.cursorrules
.cursorignore

# Call audio and the SQLite file can contain PII; they are regenerable.
data/*.db
data/audio/*
!data/audio/.gitkeep

# Model weights if a download ever lands in-tree.
.cache/
models/

# Working notes for Brandon and the agent, not the IK submission.
PROVENANCE.md
docs/
